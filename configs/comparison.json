{
  "device": "cuda",
  "precision": "fp32",
  "threads": 4,
  "seed": 42,
  "model": {
    "history": 3,
    "horizon": 4,
    "hidden": 96
  },
  "training": {
    "steps": 20000,
    "batch_size": 32,
    "lr": 0.0003
  },
  "backends": {
    "gru": {
      "backend": "gru",
      "model_options": {}
    },
    "rssm": {
      "backend": "rssm",
      "model_options": {
        "stochastic": 32,
        "kl_weight": 0.1,
        "kl_balance": 0.8,
        "free_nats": 1.0
      }
    },
    "diffusion": {
      "backend": "diffusion",
      "model_options": {
        "diffusion_steps": 100,
        "sampling_steps": 20,
        "denoising_weight": 1.0,
        "reconstruction_weight": 1.0
      }
    }
  },
  "evaluation": {
    "samples": 5,
    "seed": 42
  }
}
